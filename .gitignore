# Swift / SwiftPM build output (large, machine-specific)
.build/
build/
DerivedData/
*.xcuserstate
xcuserdata/

# macOS junk
.DS_Store
.AppleDouble
.LSOverride
._*

# Build artifacts
*.app/
*.dmg
*.pkg
*.xcarchive

# Signing material — never commit
*.p12
*.cer
*.pem
*.key
